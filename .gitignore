# Build output
build/
build_win_x64/
build_macos/
build_linux/
build_appimage/

# Third-party binary dependencies (ffmpeg dev libs, etc.)
third_party/

# Deployment / release bundle (Qt + ffmpeg DLLs, packaged exe)
deploy/

# Third-party source dependencies (e.g. googletest)
extern/

# Logs and archives
*.log
*.7z
*.zip

# Stray / scratch files
nul
WORK_DONE.md
WORK_NEXT.md
svc_*.log
test_*.log
teardown_out.txt

# Web SPA source tree — built output is committed under resources/web/,
# so the React source (incl. 154M node_modules) stays local-only.
/web-client/
